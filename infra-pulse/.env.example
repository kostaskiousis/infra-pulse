# Read by Docker Compose automatically after copying to .env.
# For native execution, set these in your shell or load them with your own env loader.
MONITOR_INTERVAL=15
MONITOR_PING_COUNT=3
MONITOR_FAILURE_THRESHOLD=2
MONITOR_CPU_ALERT=90
MONITOR_RAM_ALERT=90
MONITOR_DISK_ALERT=90
MONITOR_LOSS_ALERT=50
MONITOR_RETENTION_DAYS=14
MONITOR_TARGETS_PATH=config/targets.json
MONITOR_DB_PATH=data/monitor.db
# MONITOR_DISK_PATH=C:\\

# Leave empty to disable external notifications. Never commit your .env file.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Change before enabling Grafana or sharing access.
GRAFANA_ADMIN_PASSWORD=change-this-password
